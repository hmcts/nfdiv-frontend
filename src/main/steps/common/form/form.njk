{% from "govuk/components/button/macro.njk" import govukButton %}

<form class="form" id="main-form" method="post" action="" novalidate="novalidate">
  <input type="hidden" name="_csrf" id="csrfToken" value="{{ csrfToken }}">
  {% block form_content %}
    {% include "./fields.njk" %}
  {% endblock %}

  {% block after_fields %}{% endblock %}

  <div class="govuk-form-group">
    {{ govukButton({
      text: getContent(form.submit.text),
      classes: form.submit.classes,
      type: "submit",
      preventDoubleClick: true,
      isStartButton: form.submit.isStartButton,
      attributes: {
        id: 'main-form-submit',
        form: "main-form"
      }
    }) }}

    {% block after_form %}{% endblock %}

    <p class="govuk-body form-links">
      {% block save_and_sign_out %}
        <button class="hmcts-button-link disable-upon-submit" type="submit" name="saveAndSignOut" value="true" data-prevent-double-click="true" data-module="govuk-button" form="main-form">
          {{ saveAndSignOut }}
        </button>
      {% endblock %}

      {% block withdrawLink %}{% endblock %}
    </p>
  </div>
</form>

<form id="document-delete-form" method="post">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
</form>
